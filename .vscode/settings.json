{
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/article/_build",
    "latex-workshop.latex.tools": [
        {
            "name": "tectonic",
            "command": "pixi",
            "args": [
                "run",
                "compile",
                "%DOC_EXT%",
                "--",
                "--print", // prints extra information that LaTeX Workshop uses to display errors
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "tectonic",
            "tools": [
                "tectonic"
            ]
        }
    ]
}